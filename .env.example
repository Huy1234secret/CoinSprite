DISCORD_TOKEN=your_discord_bot_token_here
DEFAULT_GUILD_ID=1493901002519347290

# Discord OAuth dashboard
DISCORD_CLIENT_ID=your_discord_application_client_id
DISCORD_CLIENT_SECRET=your_discord_application_client_secret
DISCORD_REDIRECT_URI=http://127.0.0.1:3000/auth/discord/callback
SESSION_SECRET=replace_with_a_long_random_secret
ADMIN_WEB_HOST=127.0.0.1
ADMIN_WEB_PORT=3000
ADMIN_COOKIE_SECURE=false
# Optional public dashboard origin used for uploaded leveling images.
ADMIN_PUBLIC_URL=http://127.0.0.1:3000

# Comma-separated Discord user IDs with owner-panel access.
# The Discord application owner is always accepted.
OWNER_USER_IDS=your_discord_user_id

# Optional: post runtime logs to Discord when a future logging route is configured.
COINSPRITE_DISCORD_THREAD_LOGS=false
