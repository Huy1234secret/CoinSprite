DISCORD_TOKEN=your_discord_bot_token_here
DEFAULT_GUILD_ID=1493901002519347290

# Discord OAuth dashboard
DISCORD_CLIENT_ID=your_discord_application_client_id
DISCORD_CLIENT_SECRET=your_discord_application_client_secret
DISCORD_REDIRECT_URI=http://127.0.0.1:3000/auth/discord/callback
SESSION_SECRET=replace_with_a_long_random_secret
ADMIN_WEB_HOST=127.0.0.1
ADMIN_WEB_PORT=3000
ADMIN_COOKIE_SECURE=false
# Required on the bot container when bot and web do not share uploaded media.
# Use the public panel origin (no path). Set the same render secret in bot and web.
PUBLIC_WEB_BASE_URL=http://127.0.0.1:3000
LEVEL_CARD_RENDER_SECRET=replace_with_a_separate_shared_render_secret
# Set to the same deployed commit SHA in the bot and panel environments.
COINSPRITE_BUILD_VERSION=replace_with_the_deployed_git_commit_sha
# Optional legacy web-panel public origin.
ADMIN_PUBLIC_URL=http://127.0.0.1:3000

# Comma-separated Discord user IDs with owner-panel access.
# The Discord application owner is always accepted.
OWNER_USER_IDS=your_discord_user_id

# Optional: post runtime logs to Discord when a future logging route is configured.
COINSPRITE_DISCORD_THREAD_LOGS=false

# Optional RNG/economy persistence and centralized rarity badge overrides.
# RNG_GAME_DATABASE_PATH=./data/rng-game.sqlite
# RNG_RARITY_COMMON_EMOJI=⚪
# RNG_RARITY_UNCOMMON_EMOJI=🟢
# RNG_RARITY_RARE_EMOJI=🔵
# RNG_RARITY_EPIC_EMOJI=🟣
# RNG_RARITY_LEGENDARY_EMOJI=🟠
# RNG_RARITY_MYTHIC_EMOJI=🔴
# RNG_RARITY_SUPER_EMOJI=💠
