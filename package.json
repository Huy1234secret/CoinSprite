{
  "name": "coinsprite",
  "version": "1.0.0",
  "description": "A Discord community bot with leveling, counting, message templates, reaction roles, welcome messages, and an owner dashboard.",
  "main": "index.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/entrypoints/combined.js",
    "start:bot": "node src/entrypoints/bot.js",
    "start:panel": "node src/entrypoints/panel.js",
    "test": "node --test --test-concurrency=1",
    "generate:emoji-data": "node scripts/generateEmojiData.js",
    "predeploy:bot": "npm ci",
    "deploy:bot": "node src/entrypoints/bot.js",
    "predeploy:panel": "npm ci",
    "deploy:panel": "node src/entrypoints/panel.js"
  },
  "keywords": [
    "discord",
    "leveling",
    "counting"
  ],
  "author": "",
  "license": "ISC",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@fontsource-variable/caveat": "^5.3.0",
    "@fontsource-variable/noto-sans": "^5.3.0",
    "@fontsource-variable/noto-sans-sc": "^5.3.0",
    "@fontsource-variable/noto-serif": "^5.3.0",
    "@fontsource-variable/nunito": "^5.3.0",
    "@fontsource-variable/oswald": "^5.3.0",
    "@fontsource-variable/roboto-mono": "^5.3.0",
    "@napi-rs/canvas": "^1.0.3",
    "better-sqlite3": "^12.4.1",
    "discord.js": "^14.26.4",
    "dotenv": "^16.6.1"
  }
}
